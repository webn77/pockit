# LLM = Claude 구독(Claude Code 로그인) 기반 — API 키 불필요.
# 로그인 상태에서 `claude` CLI가 동작하면 됨. (src/llm_client.py)

# 모델 지정(선택). 비우면 Claude Code 기본 모델 사용.
ANTHROPIC_MODEL=claude-sonnet-4-6

# Chroma 영속 경로 (RAG)
CHROMA_DIR=./chroma_db

# --- reuser용: 구독 대신 API/타 provider로 바꾸려면 src/llm_client.py만 교체 ---
# ANTHROPIC_API_KEY=sk-ant-...
